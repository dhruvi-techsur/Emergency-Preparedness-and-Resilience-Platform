      "body-lg": { "size": 16, "lineHeight": 24, "weight": 400 },
      "body": { "size": 14, "lineHeight": 20, "weight": 400 },
      "body-strong": { "size": 14, "lineHeight": 20, "weight": 700 },
      "label": { "size": 13, "lineHeight": 16, "weight": 700 },
      "caption": { "size": 12, "lineHeight": 16, "weight": 400 },
      "overline": { "size": 12, "lineHeight": 16, "weight": 700, "tracking": "0.08em" },
      "code": { "size": 13, "lineHeight": 20, "weight": 400, "font": "mono" },
      "data": { "size": 14, "lineHeight": 20, "weight": 400, "font": "mono" }
    }
  },
  "motion": {
    "duration-fast": 120,
    "duration-base": 200,
    "duration-slow": 320,
