    },
    "groups": {
      "display": { "size": 40, "lineHeight": 48, "weight": 700, "tracking": "-0.02em" },
      "h1": { "size": 32, "lineHeight": 40, "weight": 700, "tracking": "-0.015em" },
      "h2": { "size": 24, "lineHeight": 32, "weight": 700, "tracking": "-0.01em" },
