{
  "realm": "epmp",
  "enabled": true,
  "clients": [
    {
      "clientId": "epmp-app",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["/auth/callback", "/auth/callback/*"],
      "webOrigins": ["*"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "groups",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "groups": [
    {
      "name": "epmp-admins",
      "path": "/epmp-admins"
    },
    {
      "name": "epmp-incident-commanders",
      "path": "/epmp-incident-commanders"
    },
    {
      "name": "epmp-planning-logistics-chiefs",
      "path": "/epmp-planning-logistics-chiefs"
    },
    {
      "name": "epmp-eoc-directors",
      "path": "/epmp-eoc-directors"
    }
  ],
  "users": [
    {
      "username": "admin@epmp.local",
      "email": "admin@epmp.local",
      "firstName": "EPMP",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "devpass123",
          "temporary": false
        }
      ],
      "groups": ["/epmp-admins"]
    },
    {
      "username": "commander@epmp.local",
      "email": "commander@epmp.local",
      "firstName": "Incident",
      "lastName": "Commander",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "devpass123",
          "temporary": false
        }
      ],
      "groups": ["/epmp-incident-commanders"]
    },
    {
      "username": "planner@epmp.local",
      "email": "planner@epmp.local",
      "firstName": "Planning",
      "lastName": "Chief",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
