{
  "name": "epmp",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "backend",
    "frontend",
    "frontend/design-system"
  ],
  "scripts": {
    "dev": "docker compose up -d db nats opa keycloak && concurrently -n backend,frontend -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "migrate": "npm run migrate -w backend",
    "seed": "npm run seed -w backend",
    "build": "npm run build -w backend",
    "test": "npm run test -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
